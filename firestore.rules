rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Replace with the Google accounts that may use the tracker.
    function allowed() {
      return request.auth != null
        && request.auth.token.email in ['you@gmail.com', 'friend@gmail.com'];
    }
    // Each person's tracker is private: only its owner can read or write it.
    match /trackers/{uid} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }
  }
}
